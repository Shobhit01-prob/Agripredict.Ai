# AgriPredict AI Environment Configuration

# Backend Settings
DATABASE_URL=sqlite:///./backend/app/agripredict.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/agripredict

JWT_SECRET=replace-with-a-secure-random-32-char-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS origins (comma-separated or configured in main.py)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Settings (optional for Vite)
VITE_API_BASE_URL=/api
